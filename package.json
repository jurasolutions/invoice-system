{
  "name": "jura-invoice-system",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Jura Solutions quotation, invoice and receipt system",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:backend": "npm run dev -w @jura/backend",
    "dev:frontend": "npm run dev -w @jura/frontend",
    "build": "npm run build -w @jura/frontend",
    "start": "npm run start -w @jura/backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npm run seed -w @jura/backend",
    "sync:ds": "npm run sync:ds -w @jura/frontend",
    "hash-password": "node backend/scripts/hash-password.mjs",
    "export": "node tools/export-pdf.mjs",
    "verify": "node tools/verify-pdf.mjs",
    "check:layout": "node tools/check-layout.mjs",
    "check:auth": "node tools/check-auth.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
