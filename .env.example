# Environment for the invoicing system. Copy what you need; never commit the
# filled-in version. `.env*` is gitignored apart from this file.
#
# Nothing loads .env automatically. Scripts that should talk to Supabase from
# your machine are run with it explicitly:
#
#   node --env-file=.env backend/scripts/create-admin.mjs admin '...'
#   node --env-file=.env backend/scripts/migrate.mjs --status
#   node --env-file=.env tools/check-postgres.mjs
#
# `npm run dev` does not read it, so local development stays on the local
# database and never writes drafts into the real records.

# ---------------------------------------------------------------- backend
# Set these in the Railway service. The server refuses to start in production
# without DATABASE_URL and SESSION_SECRET — see backend/src/auth.mjs.

# Supabase → Connect → Session pooler. NOT the direct db.<ref>.supabase.co
# host: that one is IPv6-only and Railway cannot reach it. Paste the password
# as it is; it does not need URL-encoding.
# Unset locally, the API uses PGlite under jurasolutions/data/invoices-db/.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 32+ random bytes. `openssl rand -hex 32`, or the value printed by
# `npm run hash-password`. Changing it signs everyone out.
SESSION_SECRET=

# Optional. With no users in the database, the first boot creates the admin
# from this. From `npm run hash-password -- 'your password'`. Or skip it and
# run `npm run create-admin` against the database instead.
ADMIN_PASSWORD_HASH=

# The username for the admin created from ADMIN_PASSWORD_HASH. Defaults to "admin".
ADMIN_USERNAME=

# The exact origin the frontend is served from, so the browser will send the
# session cookie cross-site. Comma-separated if there is more than one.
# A wildcard is not allowed with credentials, so this has to be spelled out.
ALLOWED_ORIGIN=https://invoice-system.jurasolutions.sg

# Railway sets PORT itself. Only set this locally.
# PORT=5175

# Rarely needed.
# JURA_DB_SCHEMA=jura          the Postgres schema the tables live in
# JURA_PGLITE_PATH=            where the local database lives
# JURA_OUTPUT_PATH=            where `npm run export` writes PDFs
# JURA_DATA_PATH=              the old JSON tree, read by `npm run migrate:json`

# --------------------------------------------------------------- frontend
# Set in the Cloudflare Pages build environment. Baked into the bundle at build
# time, so it is public — which is fine, it is just an address.
# Leave unset locally: the dev server proxies /__api to the backend instead.
VITE_API_URL=https://api.invoice.jurasolutions.sg

# ------------------------------------------------------------------ tools
# Only if the PDF export cannot find your browser.
# JURA_CHROME=
