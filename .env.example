# Environment for the invoicing system. Copy what you need; never commit the
# filled-in version. `.env*` is gitignored apart from this file.

# ---------------------------------------------------------------- backend
# Set these in the Railway service. The server refuses to start in production
# without the first two — see backend/src/auth.mjs.

# From `npm run hash-password -- 'your password'`. The password itself never
# goes in here, or anywhere else.
ADMIN_PASSWORD_HASH=

# 32+ random bytes. `openssl rand -hex 32`, or the value printed by
# `npm run hash-password`. Changing it signs everyone out.
SESSION_SECRET=

# Defaults to "admin".
ADMIN_USERNAME=

# The exact origin the frontend is served from, so the browser will send the
# session cookie cross-site. Comma-separated if there is more than one.
# A wildcard is not allowed with credentials, so this has to be spelled out.
ALLOWED_ORIGIN=https://invoice-system.jurasolutions.com

# Railway sets PORT itself. Only set this locally.
# PORT=5175

# Where the records live. Defaults to jurasolutions/data/invoices when the repo
# sits inside the domain folder, and to ./data/invoices otherwise.
#
# On Railway these MUST point inside a mounted volume, or every record is
# deleted on the next deploy. See DEPLOYMENT.md, step 3.
# JURA_DATA_PATH=/data/invoices
# JURA_OUTPUT_PATH=/data/outputs

# --------------------------------------------------------------- frontend
# Set in the Cloudflare Pages build environment. Baked into the bundle at build
# time, so it is public — which is fine, it is just an address.
# Leave unset locally: the dev server proxies /__api to the backend instead.
VITE_API_URL=https://api.jurasolutions.com

# ------------------------------------------------------------------ tools
# Only if the PDF export cannot find your browser.
# JURA_CHROME=
